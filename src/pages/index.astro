---
import "../styles/global.css";

const pageTitle = "Brandon Leong — Portfolio";
const pageDescription =
  "Brandon Leong — Software Engineer and Data Scientist at the University of Washington.";

const skills = {
  languages: [
    { name: "Python", icon: "python", type: "simple" },
    { name: "Java", icon: "/assets/java.png", type: "custom" },
    { name: "JavaScript", icon: "javascript", type: "simple" },
    { name: "Dart", icon: "dart", type: "simple" },
    { name: "HTML", icon: "html5", type: "simple" },
    { name: "CSS", icon: "/assets/css.png", type: "custom" },
    { name: "C++", icon: "cplusplus", type: "simple" },
    { name: "SQL", icon: "mysql", type: "simple" },
    { name: "R", icon: "r", type: "simple" },
  ],
  frameworks: [
    { name: "React", icon: "react", type: "simple" },
    { name: "Astro", icon: "astro", type: "simple" },
    { name: "Flutter", icon: "flutter", type: "simple" },
    { name: "Streamlit", icon: "streamlit", type: "simple" },
    { name: "OpenCV", icon: "opencv", type: "simple" },
    { name: "Tailwind CSS", icon: "tailwindcss", type: "simple" },
    { name: "Node.js", icon: "nodedotjs", type: "simple" },
    { name: "Express.js", icon: "express/ffffff", type: "simple" },
    { name: "Flask", icon: "flask/ffffff", type: "simple" },
    { name: "FastAPI", icon: "fastapi", type: "simple" },
  ],
  tools: [
    { name: "Git", icon: "git", type: "simple" },
    { name: "VS Code", icon: "/assets/vscode.png", type: "custom" },
    { name: "Figma", icon: "figma", type: "simple" },
    { name: "Netlify", icon: "netlify", type: "simple" },
    { name: "MySQL", icon: "mysql/ffffff", type: "simple" },
    { name: "MongoDB", icon: "mongodb", type: "simple" },
    { name: "Redis", icon: "redis", type: "simple" },
    { name: "Jupyter Notebook", icon: "jupyter", type: "simple" },
    { name: "PyCharm", icon: "pycharm/ffffff", type: "simple" },
    { name: "Xcode", icon: "xcode", type: "simple" },
  ],
};

const projects = [
  {
    title: "NVIDIA Stock Returns Prediction with LSTM",
    category: "DATA SCIENCE",
    image: "/assets/nvidialstm.png",
    description:
      "An advanced stock price prediction model for NVIDIA using Long Short-Term Memory (LSTM) neural networks. Incorporates financial time series data alongside sentiment analysis from news articles leveraging transformer-based NLP models. Features data preprocessing, model training with TensorFlow, and interactive visualization using Streamlit and Plotly. Demonstrates deep learning for time series forecasting, NLP integration, and end-to-end deployment of finance AI applications.",
    tags: ["Python", "TensorFlow", "Streamlit"],
    liveUrl: "https://bleongnvidiasentimentlstm.streamlit.app/",
    githubUrl: "https://github.com/bbwalrus/nvda_sentiment_lstm",
  },
  {
    title: "Midas Core Financial System",
    category: "JPMORGAN FORAGE PROGRAM",
    image: "/assets/midascore.png",
    description:
      "A high-throughput financial transaction engine developed during a JPMC Software Engineering program. The system processes real-time financial data using Apache Kafka for asynchronous message handling and ensures data integrity through a SQL database (H2/JPA). Features include automated transaction validation based on user balance and ID verification, a decoupled REST API integration for dynamic incentive calculation, and a GET endpoint for real-time balance queries. The project leverages Spring Boot's dependency injection and embedded Kafka for robust, scalable backend performance.",
    tags: ["Spring Boot", "Apache Kafka", "SQL"],
    liveUrl:
      "https://www.theforage.com/simulations/jpmorgan/advanced-software-engineering-r0fm?reloaded=true",
    githubUrl: "https://github.com/bbwalrus/forage-midas",
  },
  {
    title: "League of Legends Team Balancer",
    category: "PERSONAL PROJECT",
    image: "/assets/leaguebalancer.png",
    description:
      "A custom League of Legends analysis and team balancing tool. Uses each player's score in every role across game types such as normals, ranked, and swiftplays. Creates FIFA card-style player stats for each player, and uses algorithm that minimizes skill disparity across roles for fairer matches. Features a modern React frontend on Vercel, FastAPI backend hosted on AWS, PostgreSQL data storage in Supabase, and a team balancer that leverages historical match data for optimal team composition.",
    tags: ["React", "FastAPI", "PostgreSQL"],
    liveUrl: "https://league-of-legends-team-balancer.vercel.app",
    githubUrl: "https://github.com/bbwalrus/League-of-Legends-Team-Balancer",
  },
  {
    title: "Redis Server Implementation",
    category: "SYSTEMS PROGRAMMING",
    image: "/assets/redis.png",
    description:
      "A high-performance Redis server implementation built in C++ that supports core Redis functionality including key-value operations, lists, and hash data structures. Features thread-safe operations with mutex locking, multiple data type support, and full compatibility with Redis client protocols. Demonstrates systems programming, concurrent data structures, and network protocol implementation.",
    liveUrl: "https://github.com/bbwalrus/redis",
    githubUrl: "https://github.com/bbwalrus/redis",
  },
  {
    title: "Options Price Visualizer",
    category: "COMPUTATIONAL FINANCE",
    image: "/assets/optionspricer.png",
    description:
      "An interactive web app that allows users to price European and American options using three popular models: Black-Scholes, Binomial Tree, and Monte Carlo simulation. Users can adjust parameters such as strike price, volatility, time to maturity, and risk-free rate via sliders, and visualize option prices across different strikes.",
    liveUrl: "https://bleongoptionspricer.streamlit.app/",
    githubUrl: "https://github.com/bbwalrus/optionspricer",
  },
  {
    title: "Eatvolution",
    category: "HACKATHON PROJECT",
    image: "/assets/eatvolution.png",
    description:
      "A fitness and nutrition app that allows users to log daily meals, track calorie intake, and set personalized nutrition goals tailored to their fitness objectives. It offers access to a curated database of healthy recipes based on various dietary preferences, while also providing users with detailed progress monitoring through visual graphs and statistics. Additionally, the app includes a built-in AI trainer powered by Perplexity AI for personalized advice and goal-setting and fosters community engagement by allowing users to connect with others for support and motivation.",
    liveUrl: "https://eatvolution-frontend.onrender.com/",
    githubUrl: "https://github.com/SamGanYX/Dubhacks2024",
    additionalLink: {
      text: "Hackathon project page",
      url: "https://devpost.com/software/temp-title-ayo482",
    },
  },
  {
    title: "Handtracking Game",
    category: "COMPUTER VISION",
    image: "/assets/handtracking.png",
    description:
      "A game made in python with PyGame, OpenCV, and Google's MediaPipe to create a game where a ball bounces off of lines drawn between your index fingers and thumbs where the goal is to get the ball to hit the star 10 times as fast as possible.",
    liveUrl: "https://github.com/bbwalrus/hand-tracking-game",
    githubUrl: "https://github.com/bbwalrus/hand-tracking-game",
  },
  {
    title: "Sudoku Player",
    category: "WEB DEVELOPMENT",
    image: "/assets/sudoku.png",
    description:
      "A standard game of sudoku playable on the website. Comes with multiple difficulties, a timer, and themes. Uses HTML, CSS, and JS for functionality. Includes with a solve button that utilizes a backtracking algorithm in order to fill out the rest of the sudoku.",
    liveUrl: "https://sudoku-bleong.netlify.app",
    githubUrl: "https://github.com/bbwalrus/sudoku",
  },
  {
    title: "Algorithm Visualizer",
    category: "ALGORITHMS",
    image: "/assets/algovis.png",
    description:
      "This website uses basic React to simulate Dijkstra's Algorithm with visualized nodes. Dijkstra's Algorithm is a method to find the shortest path between nodes.",
    liveUrl: "https://algorithmvisualizer-bleong.netlify.app",
    githubUrl: "https://github.com/bbwalrus/dijkstras-algorithm-visualizer",
  },
];

const skillGroups = [
  { title: "Languages", items: skills.languages },
  { title: "Frameworks & libraries", items: skills.frameworks },
  { title: "Tools & platforms", items: skills.tools },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#100d19" />
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/assets/logofav.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="Brandon Leong, home">
        <span class="wordmark-mark" aria-hidden="true">BL</span>
        <span class="wordmark-name">BRANDON LEONG<span class="wordmark-period">.</span></span>
      </a>
      <nav class="main-nav" aria-label="Main navigation">
        <a href="#work">Work</a>
        <a href="#skills">Tech stack</a>
        <a href="#about">About</a>
        <a class="nav-contact" href="/assets/resume.pdf" target="_blank" rel="noopener noreferrer">
          Resume <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>

    <main id="top">
      <section class="hero page-wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">UNIVERSITY OF WASHINGTON · CLASS OF 2027</p>
          <h1 id="hero-title">
            Hi, I’m<br /><span class="serif-word">Brandon</span>
            <span class="hero-surname">Leong<span class="accent">.</span></span>
          </h1>
          <p class="hero-description">
            Software Engineer and Data Scientist studying at the University of Washington,
            Seattle. I like turning ideas into things people can use.
          </p>
          <div class="hero-actions">
            <a class="button button-dark" href="#work">Explore my work <span aria-hidden="true">↓</span></a>
            <a class="text-link" href="#about">A little about me <span aria-hidden="true">↗</span></a>
          </div>
          <div class="hero-footnote">
            <span class="footnote-line" aria-hidden="true"></span>
            <span>SOFTWARE ENGINEERING · DATA SCIENCE · UW SEATTLE</span>
          </div>
        </div>
        <a class="hero-index" href="#work">SCROLL TO EXPLORE&nbsp; ↓</a>
      </section>

      <section class="work-section page-wrap" id="work" aria-labelledby="work-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">A FEW THINGS I’VE MADE</p>
            <h2 id="work-title">Selected work<span class="accent">.</span></h2>
          </div>
          <p class="section-aside">
            Projects across software engineering,<br />data science, and product development.
          </p>
        </div>

        <div class="project-grid">
          {projects.map((project, index) => (
            <article class="project-card">
              <div class="project-art project-image">
                <img
                  src={project.image}
                  alt={`${project.title} project screenshot`}
                  loading="lazy"
                  decoding="async"
                />
                <span class="image-label">{project.category}</span>
              </div>
              <div class="project-meta">
                <span class="project-number">
                  {String(index + 1).padStart(2, "0")} / {project.category}
                </span>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
                {project.tags && (
                  <div class="project-tags" aria-label={`${project.title} technologies`}>
                    {project.tags.map((tag) => <span>{tag}</span>)}
                  </div>
                )}
                <div class="project-links">
                  <a href={project.liveUrl} target="_blank" rel="noopener noreferrer">
                    {project.liveUrl === project.githubUrl ? "Project details" : "Live project"}
                    <span aria-hidden="true">↗</span>
                  </a>
                  {project.liveUrl !== project.githubUrl && (
                    <a href={project.githubUrl} target="_blank" rel="noopener noreferrer">
                      Source code <span aria-hidden="true">↗</span>
                    </a>
                  )}
                  {project.additionalLink && (
                    <a
                      href={project.additionalLink.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {project.additionalLink.text} <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
        <a
          class="all-work-link"
          href="https://github.com/bbwalrus"
          target="_blank"
          rel="noopener noreferrer"
        >
          Explore more on GitHub <span aria-hidden="true">↗</span>
        </a>
      </section>

      <section class="skills-section page-wrap" id="skills" aria-labelledby="skills-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">TECHNOLOGIES I’VE WORKED WITH</p>
            <h2 id="skills-title">Tools of the trade<span class="accent">.</span></h2>
          </div>
          <p class="section-aside">
            A selection of languages, frameworks,<br />and tools from my projects and coursework.
          </p>
        </div>
        <div class="skills-list">
          {skillGroups.map((group) => (
            <div class="skill-group">
              <h3>{group.title}</h3>
              <ul>
                {group.items.map((skill) => (
                  <li>
                    <img
                      src={
                        skill.type === "custom"
                          ? skill.icon
                          : `https://cdn.simpleicons.org/${skill.icon}`
                      }
                      alt=""
                      aria-hidden="true"
                      loading="lazy"
                    />
                    <span>{skill.name}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section class="about-section" id="about" aria-labelledby="about-title">
        <div class="about-inner page-wrap">
          <div class="about-label">
            <span>ABOUT</span>
            <span>UNIVERSITY OF WASHINGTON<br />CLASS OF 2027</span>
          </div>
          <div class="about-copy">
            <p class="eyebrow">A LITTLE CONTEXT</p>
            <h2 id="about-title">About me<span class="accent">.</span></h2>
            <div class="about-bottom">
              <p>
                I’m a University of Washington Seattle student in the Class of 2027,
                studying software engineering and data science. I love logic puzzles,
                exploring new ideas, and the games I grew up with—from Minecraft and
                Skyrim to Stardew Valley. I’ve always enjoyed bringing ideas to life,
                whether in a game or in code.
              </p>
              <a
                class="button button-outline"
                href="/assets/resume.pdf"
                target="_blank"
                rel="noopener noreferrer"
              >
                View my resume <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="contact-section page-wrap" id="contact" aria-labelledby="contact-title">
        <p class="eyebrow">LINKS &amp; CONTACT</p>
        <h2 id="contact-title">More about<br /><span class="serif-word">my work.</span></h2>
        <p class="contact-description">Find my code, connect, or get in touch.</p>
        <div class="contact-links">
          <a href="/assets/resume.pdf" target="_blank" rel="noopener noreferrer">
            Resume <span aria-hidden="true">↗</span>
          </a>
          <a href="https://github.com/bbwalrus" target="_blank" rel="noopener noreferrer">
            GitHub <span aria-hidden="true">↗</span>
          </a>
          <a href="https://linkedin.com/in/brandonbleong" target="_blank" rel="noopener noreferrer">
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
          <a href="mailto:blazeleong@gmail.com">Email <span aria-hidden="true">↗</span></a>
          <a href="tel:+16692914801">Phone <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>

    <footer class="site-footer page-wrap">
      <a class="wordmark" href="#top" aria-label="Brandon Leong, back to top">
        <span class="wordmark-mark" aria-hidden="true">BL</span>
        <span class="wordmark-name">BRANDON LEONG<span class="wordmark-period">.</span></span>
      </a>
      <a
        class="footer-note"
        href="https://github.com/bbwalrus"
        target="_blank"
        rel="noopener noreferrer"
      >GITHUB ↗</a>
      <a class="back-top" href="#top">BACK TO TOP ↑</a>
      <span class="copyright">© BRANDON LEONG</span>
    </footer>
  </body>
</html>
